:8080 {
  root * /srv
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self' https: http://localhost:9000; connect-src 'self' http://localhost:9000 https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  }
  handle /api/* {
    reverse_proxy api:3000
  }
  handle {
    try_files {path} /index.html
    file_server
  }
}
