# Copy to .env.local at the repository root. Never commit the populated file.
# Neon: choose database family_stream and role family_stream_owner in Connect.
# Use pooled for DATABASE_URL, direct for DIRECT_URL; verify-full validates TLS.
DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/family_stream?sslmode=verify-full
DIRECT_URL=postgresql://<role>:<password>@<endpoint>.<region>.aws.neon.tech/family_stream?sslmode=verify-full
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=family-stream
S3_ACCESS_KEY_ID=<R2 Access Key ID>
S3_SECRET_ACCESS_KEY=<R2 Secret Access Key>
MAX_UPLOAD_BYTES=5368709120
PLAYBACK_DELIVERY=direct
# No video originals are saved in this computer's application containers.
