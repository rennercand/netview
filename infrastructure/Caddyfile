{
  email {$ACME_EMAIL}
}
{$SITE_ADDRESS} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
  handle /api/* {
    reverse_proxy api:3000
  }
  handle {
    reverse_proxy web:8080
  }
}
