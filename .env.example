NODE_ENV=development
APP_ORIGIN=http://localhost:5173
PORT=3000
# Only explicitly trusted reverse proxy CIDRs. Empty means headers are untrusted.
TRUSTED_PROXY_CIDRS=
# Development only. Replace production with Neon URLs, always using sslmode=verify-full.
DATABASE_URL=postgresql://family:local-development-only@localhost:5432/family_stream
DIRECT_URL=postgresql://family:local-development-only@localhost:5432/family_stream
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=family-stream
S3_ACCESS_KEY_ID=family-local
S3_SECRET_ACCESS_KEY=local-development-only-storage
MAX_UPLOAD_BYTES=5368709120
# direct avoids application egress; gateway reauthorizes each HTTP request.
PLAYBACK_DELIVERY=direct
# Production: public origin must be HTTPS. R2 endpoint is https://<account>.r2.cloudflarestorage.com
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=verify-full
# DIRECT_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=verify-full
# REDIS_URL=redis://:<strong-password>@redis:6379
# REDIS_PASSWORD=<strong-password>
# SITE_ADDRESS=family.example.com
# ACME_EMAIL=you@example.com
# Do not put ADMIN_PASSWORD here. Supply temporarily to the admin:create command.
