{
  "name": "family-stream",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @family/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @family/web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "pnpm --filter @family/database generate",
    "db:migrate": "pnpm --filter @family/database migrate",
    "admin:create": "tsx infrastructure/scripts/create-admin.ts",
    "ingest": "tsx infrastructure/scripts/ingest.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.0",
    "@aws-sdk/client-s3": "^3.922.0"
  },
  "type": "module"
}
